# Dockerfile.gremlin — Gremlin WebSocket server for SedanDelivery
#
# This image runs sedandelivery-gremlin as an independent service that can
# connect to any Redis/Valkey backend via the GQL_REDIS_URL environment variable.
#
# When GQL_REDIS_URL is not set, falls back to in-memory graph store.
#
# Usage:
#   docker build -f Dockerfile.gremlin -t sedandelivery-gremlin .
#   docker run -p 8182:8182 -e GQL_REDIS_URL=redis://host:6379 sedandelivery-gremlin

# ── Builder ──────────────────────────────────────────────────────────────────
FROM rust:1.89-bookworm AS builder

WORKDIR /app

# Copy workspace manifests first for layer caching
COPY Cargo.toml ./
COPY cypher-core/Cargo.toml ./cypher-core/
COPY sd2-redis-store/Cargo.toml ./sd2-redis-store/
COPY sd2-redis-module/Cargo.toml ./sd2-redis-module/
COPY gql-fabric-store/Cargo.toml ./gql-fabric-store/
COPY gql-cli/Cargo.toml ./gql-cli/
COPY sd2-api/Cargo.toml ./sd2-api/
COPY sedandelivery-bolt/Cargo.toml ./sedandelivery-bolt/
COPY sedandelivery-gremlin/Cargo.toml ./sedandelivery-gremlin/
COPY sedandelivery-gremlin-server/Cargo.toml ./sedandelivery-gremlin-server/
COPY sedandelivery-fabric-sync/Cargo.toml ./sedandelivery-fabric-sync/
COPY tests/loadtest/Cargo.toml ./tests/loadtest/

# Create stub source files so cargo can resolve the dependency graph.
RUN mkdir -p cypher-core/src sd2-redis-store/src gql-fabric-store/src sd2-redis-module/src gql-cli/src sd2-api/src \
             sedandelivery-bolt/src sedandelivery-bolt/benches sedandelivery-gremlin/src sedandelivery-gremlin-server/src \
             sedandelivery-fabric-sync/src tests/loadtest/src && \
    echo "pub fn stub() {}" > cypher-core/src/lib.rs && \
    echo "pub fn stub() {}" > sd2-redis-store/src/lib.rs && \
    echo "pub fn stub() {}" > gql-fabric-store/src/lib.rs && \
    echo "pub fn stub() {}" > sd2-redis-module/src/lib.rs && \
    echo "fn main() {}" > gql-cli/src/main.rs && \
    echo "fn main() {}" > sd2-api/src/main.rs && \
    echo "pub fn stub() {}" > sedandelivery-bolt/src/lib.rs && \
    echo "fn main() {}" > sedandelivery-bolt/src/main.rs && \
    echo "fn main() {}" > sedandelivery-bolt/benches/bolt_benchmarks.rs && \
    echo "fn main() {}" > sedandelivery-gremlin/src/main.rs && \
    echo "fn main() {}" > sedandelivery-gremlin-server/src/main.rs && \
    echo "fn main() {}" > sedandelivery-fabric-sync/src/main.rs && \
    echo "fn main() {}" > tests/loadtest/src/main.rs && \
    cargo build --release -p sedandelivery-gremlin 2>/dev/null || true

# Copy actual source code
COPY cypher-core/ ./cypher-core/
COPY sd2-redis-store/ ./sd2-redis-store/
COPY sedandelivery-gremlin/ ./sedandelivery-gremlin/

# Build the gremlin binary
RUN touch cypher-core/src/lib.rs sd2-redis-store/src/lib.rs sedandelivery-gremlin/src/main.rs && \
    cargo build --release -p sedandelivery-gremlin && \
    ls -lh target/release/sedandelivery-gremlin

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

# Install minimal runtime dependencies
RUN apt-get update -q && \
    apt-get install -y -q --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/sedandelivery-gremlin /usr/local/bin/sedandelivery-gremlin

# Gremlin WebSocket port + health HTTP port
EXPOSE 8182 8183

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:8183/health || exit 1

# Run as non-root for security
RUN useradd --system --no-create-home gremlin
USER gremlin

ENTRYPOINT ["sedandelivery-gremlin"]
