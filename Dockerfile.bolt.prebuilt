# CI-only image that copies a host-built sedandelivery-bolt binary.
#
# Build the binary first, then use the helper script:
#   cargo build --release -p sedandelivery-bolt
#   ./scripts/build-prebuilt-bolt-image.sh

FROM debian:bookworm-slim

RUN apt-get update -q && \
    apt-get install -y -q --no-install-recommends \
        ca-certificates \
        curl \
        libssl3 && \
    rm -rf /var/lib/apt/lists/*

COPY target/release/sedandelivery-bolt /usr/local/bin/sedandelivery-bolt

EXPOSE 7687 7688

ENTRYPOINT ["/usr/local/bin/sedandelivery-bolt"]
