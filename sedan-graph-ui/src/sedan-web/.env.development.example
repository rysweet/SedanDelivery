# Copy this file to .env.development and customize for your environment

# VITE_API_URL is the base URL for the .NET BFF API
VITE_API_URL=http://localhost:5000

# Entra ID (Azure AD) OIDC configuration
# Client ID of the SedanDelivery app registration in Entra ID
VITE_ENTRA_CLIENT_ID=97926b31-e1a3-4a76-b09d-eed5aeeabc9f
# Tenant ID for your Azure AD directory
VITE_ENTRA_TENANT_ID=3cd87a41-1f61-4aef-a212-cefdecd9a2d1
# API scope exposed by the app registration for Graph.ReadWrite access
VITE_ENTRA_API_SCOPE=api://97926b31-e1a3-4a76-b09d-eed5aeeabc9f/Graph.ReadWrite
