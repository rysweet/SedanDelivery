// MITRE ATT&CK Framework — Sample Dataset for SedanDelivery Neo4j Compatibility Gallery
// Covers: Threat Actors, Campaigns, Techniques, Software, Mitigations, Data Sources
// ~150 nodes, ~250 relationships — representative subset of the ATT&CK knowledge base

// ── Threat Groups ──────────────────────────────────────────────────────────
CREATE (apt28:ThreatGroup {name: 'APT28', aliases: 'Fancy Bear, Sofacy, Sednit', country: 'Russia', first_seen: '2004', description: 'Russian military intelligence (GRU) unit targeting government, military, and security organizations'})
CREATE (apt29:ThreatGroup {name: 'APT29', aliases: 'Cozy Bear, The Dukes', country: 'Russia', first_seen: '2008', description: 'Russian intelligence service (SVR) targeting diplomatic and policy organizations'})
CREATE (lazarus:ThreatGroup {name: 'Lazarus Group', aliases: 'HIDDEN COBRA, Zinc', country: 'North Korea', first_seen: '2009', description: 'North Korean state-sponsored group targeting financial institutions and critical infrastructure'})
CREATE (apt41:ThreatGroup {name: 'APT41', aliases: 'Double Dragon, Winnti', country: 'China', first_seen: '2012', description: 'Chinese state-sponsored espionage group also conducting financially motivated operations'})
CREATE (fin7:ThreatGroup {name: 'FIN7', aliases: 'Carbanak, Navigator Group', country: 'Unknown', first_seen: '2013', description: 'Financially motivated threat group targeting the retail, restaurant, and hospitality sectors'})
CREATE (sandworm:ThreatGroup {name: 'Sandworm', aliases: 'Voodoo Bear, IRIDIUM', country: 'Russia', first_seen: '2009', description: 'Russian GRU unit targeting critical infrastructure and election systems'})
CREATE (turla:ThreatGroup {name: 'Turla', aliases: 'Snake, Venomous Bear', country: 'Russia', first_seen: '2004', description: 'Russian FSB-linked group targeting government and diplomatic entities'})
CREATE (hafnium:ThreatGroup {name: 'HAFNIUM', aliases: 'Silk Typhoon', country: 'China', first_seen: '2021', description: 'Chinese state-sponsored group exploiting Exchange vulnerabilities'})

// ── ATT&CK Tactics ─────────────────────────────────────────────────────────
CREATE (recon:Tactic {id: 'TA0043', name: 'Reconnaissance', description: 'Gathering information to plan future operations'})
CREATE (resource:Tactic {id: 'TA0042', name: 'Resource Development', description: 'Establishing resources to support operations'})
CREATE (initial:Tactic {id: 'TA0001', name: 'Initial Access', description: 'Gaining initial foothold in target environment'})
CREATE (exec:Tactic {id: 'TA0002', name: 'Execution', description: 'Running adversary-controlled code'})
CREATE (persist:Tactic {id: 'TA0003', name: 'Persistence', description: 'Maintaining access across restarts'})
CREATE (privesc:Tactic {id: 'TA0004', name: 'Privilege Escalation', description: 'Gaining higher-level permissions'})
CREATE (defense:Tactic {id: 'TA0005', name: 'Defense Evasion', description: 'Avoiding detection'})
CREATE (cred:Tactic {id: 'TA0006', name: 'Credential Access', description: 'Stealing account credentials'})
CREATE (disc:Tactic {id: 'TA0007', name: 'Discovery', description: 'Understanding the target environment'})
CREATE (lateral:Tactic {id: 'TA0008', name: 'Lateral Movement', description: 'Moving through the target environment'})
CREATE (collect:Tactic {id: 'TA0009', name: 'Collection', description: 'Gathering data of interest'})
CREATE (c2:Tactic {id: 'TA0011', name: 'Command and Control', description: 'Communicating with compromised systems'})
CREATE (exfil:Tactic {id: 'TA0010', name: 'Exfiltration', description: 'Stealing data from the target'})
CREATE (impact:Tactic {id: 'TA0040', name: 'Impact', description: 'Disrupting availability or compromising integrity'})

// ── ATT&CK Techniques ──────────────────────────────────────────────────────
CREATE (t1566:Technique {id: 'T1566', name: 'Phishing', description: 'Sending messages to gain access via social engineering'})
CREATE (t1566_001:Technique {id: 'T1566.001', name: 'Spearphishing Attachment', description: 'Sending spearphishing emails with malicious attachments'})
CREATE (t1566_002:Technique {id: 'T1566.002', name: 'Spearphishing Link', description: 'Sending spearphishing emails with malicious links'})
CREATE (t1190:Technique {id: 'T1190', name: 'Exploit Public-Facing Application', description: 'Exploiting vulnerabilities in internet-facing applications'})
CREATE (t1059:Technique {id: 'T1059', name: 'Command and Scripting Interpreter', description: 'Abusing command interpreters to execute commands'})
CREATE (t1059_001:Technique {id: 'T1059.001', name: 'PowerShell', description: 'Using PowerShell for execution'})
CREATE (t1059_003:Technique {id: 'T1059.003', name: 'Windows Command Shell', description: 'Using cmd.exe for execution'})
CREATE (t1053:Technique {id: 'T1053', name: 'Scheduled Task/Job', description: 'Scheduling task execution for persistence'})
CREATE (t1078:Technique {id: 'T1078', name: 'Valid Accounts', description: 'Using legitimate credentials for access'})
CREATE (t1078_003:Technique {id: 'T1078.003', name: 'Local Accounts', description: 'Using compromised local account credentials'})
CREATE (t1003:Technique {id: 'T1003', name: 'OS Credential Dumping', description: 'Dumping credentials from the operating system'})
CREATE (t1003_001:Technique {id: 'T1003.001', name: 'LSASS Memory', description: 'Dumping credentials from LSASS process memory'})
CREATE (t1021:Technique {id: 'T1021', name: 'Remote Services', description: 'Using remote services for lateral movement'})
CREATE (t1021_001:Technique {id: 'T1021.001', name: 'Remote Desktop Protocol', description: 'Using RDP for lateral movement'})
CREATE (t1021_002:Technique {id: 'T1021.002', name: 'SMB/Windows Admin Shares', description: 'Using Windows admin shares for lateral movement'})
CREATE (t1071:Technique {id: 'T1071', name: 'Application Layer Protocol', description: 'Using standard protocols for C2 communication'})
CREATE (t1071_001:Technique {id: 'T1071.001', name: 'Web Protocols', description: 'Using HTTP/HTTPS for C2'})
CREATE (t1048:Technique {id: 'T1048', name: 'Exfiltration Over Alternative Protocol', description: 'Stealing data via non-standard protocol'})
CREATE (t1486:Technique {id: 'T1486', name: 'Data Encrypted for Impact', description: 'Encrypting data to disrupt availability (ransomware)'})
CREATE (t1027:Technique {id: 'T1027', name: 'Obfuscated Files or Information', description: 'Making files or information difficult to discover or analyze'})
CREATE (t1036:Technique {id: 'T1036', name: 'Masquerading', description: 'Manipulating features to appear legitimate'})
CREATE (t1055:Technique {id: 'T1055', name: 'Process Injection', description: 'Injecting code into processes for evasion and escalation'})
CREATE (t1082:Technique {id: 'T1082', name: 'System Information Discovery', description: 'Attempting to get detailed information about the OS'})
CREATE (t1083:Technique {id: 'T1083', name: 'File and Directory Discovery', description: 'Enumerating files and directories'})
CREATE (t1018:Technique {id: 'T1018', name: 'Remote System Discovery', description: 'Attempting to discover remote systems on the network'})
CREATE (t1560:Technique {id: 'T1560', name: 'Archive Collected Data', description: 'Compressing/encrypting data prior to exfiltration'})
CREATE (t1105:Technique {id: 'T1105', name: 'Ingress Tool Transfer', description: 'Transferring tools into the compromised environment'})
CREATE (t1547:Technique {id: 'T1547', name: 'Boot or Logon Autostart Execution', description: 'Configuring persistence via startup mechanisms'})
CREATE (t1562:Technique {id: 'T1562', name: 'Impair Defenses', description: 'Disabling or modifying security tools and features'})

// ── Malware & Tools ────────────────────────────────────────────────────────
CREATE (mimikatz:Software {name: 'Mimikatz', type: 'tool', description: 'Credential extraction tool for Windows', author: 'Benjamin Delpy'})
CREATE (cobalt:Software {name: 'Cobalt Strike', type: 'tool', description: 'Commercial adversary simulation and red team framework'})
CREATE (emotet:Software {name: 'Emotet', type: 'malware', description: 'Banking trojan turned botnet and malware distribution service'})
CREATE (trickbot:Software {name: 'TrickBot', type: 'malware', description: 'Banking trojan with modular architecture for data theft'})
CREATE (ryuk:Software {name: 'Ryuk', type: 'malware', description: 'Ransomware targeting enterprise environments'})
CREATE (notpetya:Software {name: 'NotPetya', type: 'malware', description: 'Destructive wiper disguised as ransomware'})
CREATE (solarwinds:Software {name: 'SUNBURST', type: 'malware', description: 'Trojanized SolarWinds Orion update used in supply chain attack'})
CREATE (xloader:Software {name: 'XLoader', type: 'malware', description: 'Cross-platform keylogger and form-grabber'})
CREATE (bloodhound_tool:Software {name: 'BloodHound', type: 'tool', description: 'Active Directory attack path discovery tool'})
CREATE (psexec:Software {name: 'PsExec', type: 'tool', description: 'Sysinternals tool for remote command execution'})
CREATE (proxyshell:Software {name: 'ProxyShell', type: 'exploit', description: 'Microsoft Exchange Server vulnerability chain (CVE-2021-34473, -34523, -31207)'})

// ── CVEs ───────────────────────────────────────────────────────────────────
CREATE (cve_2021_44228:CVE {id: 'CVE-2021-44228', name: 'Log4Shell', severity: 'CRITICAL', cvss: 10.0, affected: 'Apache Log4j 2.x', description: 'Remote code execution via JNDI injection in log messages'})
CREATE (cve_2021_34473:CVE {id: 'CVE-2021-34473', name: 'ProxyShell Pre-Auth', severity: 'CRITICAL', cvss: 9.8, affected: 'Microsoft Exchange Server', description: 'Pre-authentication path confusion for arbitrary backend access'})
CREATE (cve_2023_23397:CVE {id: 'CVE-2023-23397', name: 'Outlook Elevation of Privilege', severity: 'CRITICAL', cvss: 9.8, affected: 'Microsoft Outlook', description: 'NTLM relay via crafted calendar reminder'})
CREATE (cve_2020_1472:CVE {id: 'CVE-2020-1472', name: 'Zerologon', severity: 'CRITICAL', cvss: 10.0, affected: 'Windows Netlogon', description: 'Cryptographic flaw allowing domain controller compromise'})
CREATE (cve_2024_3094:CVE {id: 'CVE-2024-3094', name: 'XZ Utils Backdoor', severity: 'CRITICAL', cvss: 10.0, affected: 'XZ Utils 5.6.0-5.6.1', description: 'Supply chain compromise via malicious maintainer'})
CREATE (cve_2023_44487:CVE {id: 'CVE-2023-44487', name: 'HTTP/2 Rapid Reset', severity: 'HIGH', cvss: 7.5, affected: 'HTTP/2 implementations', description: 'DDoS amplification via rapid stream reset'})

// ── Campaigns ──────────────────────────────────────────────────────────────
CREATE (solarwinds_campaign:Campaign {name: 'SolarWinds Supply Chain', year: 2020, description: 'Nation-state supply chain attack via trojanized SolarWinds updates', sector: 'Government, Technology'})
CREATE (colonial:Campaign {name: 'Colonial Pipeline', year: 2021, description: 'Ransomware attack causing major US fuel pipeline shutdown', sector: 'Energy'})
CREATE (exchange_campaign:Campaign {name: 'ProxyShell Exchange Exploitation', year: 2021, description: 'Mass exploitation of Exchange servers worldwide', sector: 'Cross-sector'})
CREATE (log4shell_campaign:Campaign {name: 'Log4Shell Exploitation Wave', year: 2021, description: 'Global exploitation of Log4j vulnerability', sector: 'Cross-sector'})
CREATE (ukraine_power:Campaign {name: 'Ukraine Power Grid Attack', year: 2015, description: 'First known successful cyberattack on a power grid', sector: 'Energy, Critical Infrastructure'})

// ── Mitigations ────────────────────────────────────────────────────────────
CREATE (m1049:Mitigation {id: 'M1049', name: 'Antivirus/Antimalware', description: 'Use signatures to detect and prevent malicious software execution'})
CREATE (m1032:Mitigation {id: 'M1032', name: 'Multi-factor Authentication', description: 'Use multi-factor authentication for remote access'})
CREATE (m1026:Mitigation {id: 'M1026', name: 'Privileged Account Management', description: 'Manage creation and permissions of privileged accounts'})
CREATE (m1051:Mitigation {id: 'M1051', name: 'Update Software', description: 'Perform regular software updates to mitigate exploitation risk'})
CREATE (m1054:Mitigation {id: 'M1054', name: 'Software Configuration', description: 'Implement application configuration changes to reduce attack surface'})
CREATE (m1031:Mitigation {id: 'M1031', name: 'Network Intrusion Prevention', description: 'Use IDS/IPS to detect and prevent intrusions'})
CREATE (m1030:Mitigation {id: 'M1030', name: 'Network Segmentation', description: 'Segment networks to limit lateral movement'})

