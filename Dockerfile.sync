# Dockerfile.sync — builds the sedan-fabric-sync sidecar binary.
#
# This container:
#   - Reads the __sd2:changelog Valkey stream
#   - Replays each ChangeEvent against Microsoft Fabric Graph Database
#   - Exits cleanly on startup when GQL_FABRIC_ENDPOINT is not set
#
# Deploy as a sidecar alongside the main Valkey+gql-module container.
# Enable by setting ENABLE_FABRIC=true in the deploy workflow.

# ── Builder ───────────────────────────────────────────────────────────────────
FROM rust:1.89-bookworm AS builder

WORKDIR /app

# Install libclang (required for redis-module bindgen — even though
# sedan-fabric-sync itself doesn't use redis-module, gql-module is in the same
# workspace and cargo resolves all crate dependencies before building).
RUN apt-get update -q && apt-get install -y -q libclang-dev && rm -rf /var/lib/apt/lists/*

# Copy workspace manifests for layer caching
COPY Cargo.toml ./
COPY gql-core/Cargo.toml             ./gql-core/
COPY gql-redis-store/Cargo.toml      ./gql-redis-store/
COPY gql-fabric-store/Cargo.toml     ./gql-fabric-store/
COPY gql-module/Cargo.toml           ./gql-module/
COPY gql-cli/Cargo.toml              ./gql-cli/
COPY gql-api/Cargo.toml              ./gql-api/
COPY sedan-bolt/Cargo.toml           ./sedan-bolt/
COPY sedan-fabric-sync/Cargo.toml    ./sedan-fabric-sync/

# Stub sources so cargo can resolve the dependency graph
RUN mkdir -p gql-core/src gql-redis-store/src gql-fabric-store/src \
             gql-module/src gql-cli/src gql-api/src \
             sedan-bolt/src sedan-fabric-sync/src && \
    echo "pub fn stub() {}" > gql-core/src/lib.rs && \
    echo "pub fn stub() {}" > gql-redis-store/src/lib.rs && \
    echo "pub fn stub() {}" > gql-fabric-store/src/lib.rs && \
    echo "pub fn stub() {}" > gql-module/src/lib.rs && \
    echo "fn main() {}" > gql-cli/src/main.rs && \
    echo "fn main() {}" > gql-api/src/main.rs && \
    echo "pub fn stub() {}" > sedan-bolt/src/lib.rs && \
    echo "fn main() {}" > sedan-fabric-sync/src/main.rs && \
    cargo build --release -p sedan-fabric-sync 2>/dev/null || true

# Copy actual source
COPY gql-core/         ./gql-core/
COPY gql-redis-store/  ./gql-redis-store/
COPY gql-fabric-store/ ./gql-fabric-store/
COPY gql-module/       ./gql-module/
COPY gql-cli/          ./gql-cli/
COPY gql-api/          ./gql-api/
COPY sedan-bolt/       ./sedan-bolt/
COPY sedan-fabric-sync/ ./sedan-fabric-sync/

# Build only the sync binary
RUN touch gql-core/src/lib.rs gql-redis-store/src/lib.rs gql-fabric-store/src/lib.rs \
         gql-module/src/lib.rs sedan-fabric-sync/src/main.rs && \
    cargo build --release -p sedan-fabric-sync && \
    ls -lh target/release/sedan-fabric-sync

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update -q && \
    apt-get install -y -q --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/sedan-fabric-sync /usr/local/bin/sedan-fabric-sync

# Run as non-root
RUN useradd --no-create-home --shell /bin/false sync
USER sync

# Configuration via environment variables:
#   GQL_REDIS_URL            (default: redis://127.0.0.1:6379)
#   GQL_FABRIC_ENDPOINT      (required — exit 0 if missing)
#   GQL_FABRIC_TENANT_ID     (required)
#   GQL_FABRIC_CLIENT_ID     (required)
#   GQL_FABRIC_CLIENT_SECRET (required — inject as a secret reference)
#   SD2_SYNC_BATCH           (optional, default 100)
#   SD2_SYNC_BLOCK_MS        (optional, default 1000)
#   SD2_SYNC_MAX_RETRIES     (optional, default 3)

ENTRYPOINT ["/usr/local/bin/sedan-fabric-sync"]
