# Dockerfile.sync — builds the sedandelivery-fabric-sync sidecar binary.
#
# This container:
#   - Reads the __sd2:changelog Valkey stream
#   - Replays each ChangeEvent against Microsoft Fabric Graph Database
#   - Exits cleanly on startup when GQL_FABRIC_ENDPOINT is not set
#
# Deploy as a sidecar alongside the main Valkey+sd2-redis-module container.
# Enable by setting ENABLE_FABRIC=true in the deploy workflow.

# ── Builder ───────────────────────────────────────────────────────────────────
FROM rust:1.89-bookworm AS builder

WORKDIR /app

# Install libclang (required for redis-module bindgen — even though
# sedandelivery-fabric-sync itself doesn't use redis-module, sd2-redis-module is in the same
# workspace and cargo resolves all crate dependencies before building).
RUN apt-get update -q && apt-get install -y -q libclang-dev && rm -rf /var/lib/apt/lists/*

# Copy workspace manifests and lockfile for layer caching.
# Cargo.lock is committed — copy it for reproducible dependency resolution.
# Fixes #1000: all workspace members must be present for cargo to load the workspace.
COPY Cargo.toml Cargo.lock ./
COPY cypher-core/Cargo.toml              ./cypher-core/
COPY sd2-redis-store/Cargo.toml       ./sd2-redis-store/
COPY gql-fabric-store/Cargo.toml      ./gql-fabric-store/
COPY sd2-redis-module/Cargo.toml            ./sd2-redis-module/
COPY gql-cli/Cargo.toml               ./gql-cli/
COPY sd2-api/Cargo.toml               ./sd2-api/
COPY sedandelivery-bolt/Cargo.toml    ./sedandelivery-bolt/
COPY sedandelivery-fabric-sync/Cargo.toml ./sedandelivery-fabric-sync/
COPY sedandelivery-gremlin/Cargo.toml ./sedandelivery-gremlin/
COPY sedandelivery-gremlin-server/Cargo.toml ./sedandelivery-gremlin-server/
COPY gremlin-core/Cargo.toml          ./gremlin-core/
COPY gql-engine/Cargo.toml            ./gql-engine/
COPY sedan-gql-embedded/Cargo.toml    ./sedan-gql-embedded/
COPY sedan-cypher-embedded/Cargo.toml ./sedan-cypher-embedded/
COPY sedan-gremlin-embedded/Cargo.toml ./sedan-gremlin-embedded/
COPY tests/loadtest/Cargo.toml        ./tests/loadtest/
COPY tests/gremlin-tck/Cargo.toml     ./tests/gremlin-tck/
COPY tests/bolt-driver-conformance/Cargo.toml ./tests/bolt-driver-conformance/
COPY tests/embedded-bench/Cargo.toml  ./tests/embedded-bench/
COPY tests/embedded-fuzz/Cargo.toml   ./tests/embedded-fuzz/
COPY tests/bolt-fuzz/Cargo.toml       ./tests/bolt-fuzz/
COPY tests/concurrent-stress/Cargo.toml ./tests/concurrent-stress/
COPY tests/scalability/Cargo.toml     ./tests/scalability/
COPY tests/soak/Cargo.toml            ./tests/soak/
COPY tests/differential/Cargo.toml    ./tests/differential/
COPY examples/embedded_app/Cargo.toml ./examples/embedded_app/
COPY examples/embedded_quickstart/Cargo.toml ./examples/embedded_quickstart/

# Stub sources so cargo can resolve the full workspace dependency graph.
# Generate stub source files so cargo can resolve the full workspace dependency
# graph during the dependency pre-caching layer. This replaces a manual
# mkdir/echo wall that had to be edited for every new member or bench (and
# produced merge conflicts on every parallel feature branch — see
# #1272/#1273/#1274 history). The script enumerates workspace members and
# their [[bench]] / [[bin]] targets from Cargo.toml.
COPY scripts/generate-cargo-stubs.sh ./scripts/
RUN chmod +x scripts/generate-cargo-stubs.sh && \
    scripts/generate-cargo-stubs.sh && \
    cargo build --release -p sedandelivery-fabric-sync 2>/dev/null || true

# Copy actual source (only crates sedandelivery-fabric-sync depends on)
COPY cypher-core/         ./cypher-core/
COPY sd2-redis-store/  ./sd2-redis-store/
COPY gql-fabric-store/ ./gql-fabric-store/
COPY sedandelivery-fabric-sync/ ./sedandelivery-fabric-sync/

# Build only the sync binary.
# --locked pins to committed Cargo.lock versions for reproducible builds (#1000).
RUN touch cypher-core/src/lib.rs sd2-redis-store/src/lib.rs gql-fabric-store/src/lib.rs \
         sedandelivery-fabric-sync/src/main.rs && \
    cargo build --release --locked -p sedandelivery-fabric-sync && \
    ls -lh target/release/sedandelivery-fabric-sync

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update -q && \
    apt-get install -y -q --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/sedandelivery-fabric-sync /usr/local/bin/sedandelivery-fabric-sync

# Run as non-root
RUN useradd --no-create-home --shell /bin/false syncuser
USER syncuser

# Configuration via environment variables:
#   GQL_REDIS_URL            (default: redis://127.0.0.1:6379)
#   GQL_FABRIC_ENDPOINT      (required — exit 0 if missing)
#   GQL_FABRIC_TENANT_ID     (required)
#   GQL_FABRIC_CLIENT_ID     (required)
#   GQL_FABRIC_CLIENT_SECRET (required — inject as a secret reference)
#   SD2_SYNC_BATCH           (optional, default 100)
#   SD2_SYNC_BLOCK_MS        (optional, default 1000)
#   SD2_SYNC_MAX_RETRIES     (optional, default 3)

ENTRYPOINT ["/usr/local/bin/sedandelivery-fabric-sync"]
